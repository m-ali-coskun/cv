{
  "name": "designtab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "designTab — the collaboration hub where freelance designers and clients match, brief, chat and ship work together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
